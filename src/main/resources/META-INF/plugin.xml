<idea-plugin>
    <id>dev.rooster.plugin</id>
    <name>Rooster</name>
    <vendor>leovilhena</vendor>

    <description><![CDATA[
        Offline AI assistant for PyCharm, backed by a local
        <a href="https://github.com/drumih/turbo-fieldfare">TurboFieldfare</a> server on 127.0.0.1.
        Chat, read-only repo tools, gated file edits and shell commands, and
        opt-in inline completion &mdash; nothing leaves the machine.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.python</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService
                serviceImplementation="dev.rooster.plugin.settings.RoosterSettings"/>
        <applicationConfigurable
                parentId="tools"
                id="dev.rooster.settings"
                displayName="Rooster"
                instance="dev.rooster.plugin.settings.RoosterConfigurable"/>
        <inline.completion.provider
                implementation="dev.rooster.plugin.completion.RoosterInlineCompletionProvider"/>
        <toolWindow id="Rooster"
                    anchor="right"
                    icon="AllIcons.Toolwindows.ToolWindowMessages"
                    factoryClass="dev.rooster.plugin.ui.RoosterToolWindowFactory"/>
    </extensions>

    <actions>
        <!-- Shape verified against the bundled Markdown plugin's own plugin.xml:
             an <add-to-group> child naming group-id="EditorPopupMenu". -->
        <action id="Rooster.AttachSelection"
                class="dev.rooster.plugin.ui.AttachSelectionAction"
                text="Attach to Rooster Chat"
                description="Send the selected lines (or the whole file) to Rooster with your next message">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
